// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (better-auth compatible) ─────────────────────

model User {
  id                 String       @id @default(cuid())
  name               String?
  email              String       @unique
  emailVerified      Boolean      @default(false)
  image              String?
  role               Role         @default(USER)
  referralCode       String       @unique @default(cuid())
  walletBalance      Int          @default(0)
  isPremiumActive    Boolean      @default(false)
  currentPremiumTier PremiumTier?
  premiumExpiryDate  DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions  Session[]
  accounts  Account[]
  purchases PremiumPurchase[]

  referredById  String?
  referredBy    User?   @relation("Referrer", fields: [referredById], references: [id])
  referredUsers User[]  @relation("Referrer")

  referralRewardsGiven  ReferralReward[] @relation("ReferrerReward")
  referralRewardsEarned ReferralReward[] @relation("RefereeReward")

  questionProgress    QuestionProgress[]
  experiences         Experience[]
  approvedExperiences Experience[]       @relation("Approver")
  savedJobs           SavedJob[]
  jobApplications     JobApplication[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                  String    @id @default(cuid())
  accountId           String
  providerId          String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken         String?
  refreshToken        String?
  idToken             String?
  accessTokenExpiresAt DateTime?
  expiresAt           DateTime?
  password            String?
  scope               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ─── Questions ─────────────────────────────────────────

model Language {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  questionSets QuestionSet[]
}

model Field {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  questionSets QuestionSet[]
  questions    Question[]
}

model QuestionSet {
  id             String   @id @default(cuid())
  title          String
  description    String?
  languageId     String
  language       Language @relation(fields: [languageId], references: [id])
  fieldId        String
  field          Field    @relation(fields: [fieldId], references: [id])
  isPremium      Boolean  @default(false)
  totalQuestions Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questions Question[]

  @@unique([languageId, fieldId])
}

model Question {
  id            String       @id @default(cuid())
  content       String
  answer        String
  difficulty    Difficulty   @default(MEDIUM)
  tags          String[]     @default([])
  questionSetId String?
  questionSet   QuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id])
  fieldId       String?
  field         Field?       @relation(fields: [fieldId], references: [id])
  order         Int
  createdAt     DateTime     @default(now())

  progress QuestionProgress[]

  @@index([questionSetId])
  @@index([categoryId])
  @@index([fieldId])
  @@index([difficulty])
}

model QuestionProgress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isBookmarked Boolean  @default(false)
  isSolved     Boolean  @default(false)
  viewedAt     DateTime @default(now())

  @@unique([userId, questionId])
}

// ─── Category ─────────────────────────────────────────

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions Question[]
}

// ─── Company & Job ─────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logo      String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]
}

model Job {
  id              String           @id @default(cuid())
  title           String
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  type            JobType
  location        String?
  description     String?
  applyUrl        String?
  salaryMin       Int?
  salaryMax       Int?
  isRemote        Boolean          @default(false)
  isStartup       Boolean          @default(false)
  isHFT           Boolean          @default(false)
  tags            String[]         @default([])
  postedAt        DateTime         @default(now())
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  savedJobs       SavedJob[]
  jobApplications JobApplication[]

  @@index([companyId])
  @@index([type])
  @@index([isRemote])
  @@index([isStartup])
  @@index([isHFT])
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
}

model JobApplication {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, jobId])
}

enum ApplicationStatus {
  SAVED
  APPLIED
  IN_PROGRESS
}

// ─── Premium & Payments ────────────────────────────────

enum PremiumTier {
  TIER_1
  TIER_2
  TIER_3
}

model PremiumPurchase {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  tier              PremiumTier
  durationMonths    Int
  amountPaid        Int
  discountApplied   Int           @default(0)
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentStatus     PaymentStatus @default(PENDING)
  referralCodeUsed  String?
  referralDiscount  Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model DiscountCoupon {
  id         String       @id @default(cuid())
  code       String       @unique
  type       DiscountType
  value      Int
  maxUses    Int?
  usedCount  Int          @default(0)
  validUntil DateTime
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ─── Referral ─────────────────────────────────────────

model ReferralReward {
  id         String       @id @default(cuid())
  referrerId String
  referrer   User         @relation("ReferrerReward", fields: [referrerId], references: [id])
  refereeId  String
  referee    User         @relation("RefereeReward", fields: [refereeId], references: [id])
  amount     Int
  status     RewardStatus @default(PENDING)
  createdAt  DateTime     @default(now())
}

enum RewardStatus {
  PENDING
  CREDITED
  EXPIRED
}

// ─── Interview Experiences ────────────────────────────

model Experience {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  title          String
  company        String
  role           String
  content        String
  status         ExperienceStatus @default(PENDING)
  rejectedReason String?
  approvedById   String?
  approvedBy     User?            @relation("Approver", fields: [approvedById], references: [id])
  views          Int              @default(0)
  likes          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum ExperienceStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Common Enums ─────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
